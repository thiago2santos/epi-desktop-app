#!/usr/bin/env bash
set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG="$(head -n1 "$COMMIT_MSG_FILE")"

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9._-]+\))?!?: .+'

if [[ ! "$COMMIT_MSG" =~ $PATTERN ]]; then
  echo "Mensagem de commit invalida."
  echo "Use Conventional Commits. Exemplo:"
  echo "feat(core): adiciona bloqueio de lote vencido"
  exit 1
fi
